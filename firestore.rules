rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Correo verificado: sin esto, alguien podría registrarse con el correo de un empleado
    function verificado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function correo() {
      return request.auth.token.email.lower();
    }

    function miUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(correo())).data;
    }

    // Empleado activo que ya cambió su contraseña temporal
    function esEmpleado() {
      return verificado()
        && miUsuario().activo == true
        && miUsuario().debe_cambiar_contrasena == false;
    }

    // Permisos guardados en usuarios/{correo}. Ejemplo: "ingredientes:leer"
    function tienePermiso(permiso) {
      return esEmpleado() && permiso in miUsuario().permisos;
    }

    // Solo se gestiona a quien tiene un nivel menor al propio. El administrador gestiona a todos.
    function gestiona(nivel) {
      return miUsuario().nivel >= 5 || miUsuario().nivel > nivel;
    }

    // Los datos de cómo quedará un cargo al terminar la operación
    function cargoDespues(idCargo) {
      return getAfter(/databases/$(database)/documents/cargos/$(idCargo)).data;
    }

    // El nivel y los permisos de un usuario salen de su cargo: nadie los elige a mano.
    // El administrador tiene todos los permisos, aunque su cargo no los tenga marcados.
    function usuarioValido() {
      let d = request.resource.data;
      let cargo = cargoDespues(d.id_cargo);
      return d.nivel == cargo.nivel_acceso
        && d.cargo == cargo.nombre_cargo
        && (cargo.nivel_acceso >= 5 || d.permisos.toSet() == cargo.permisos.toSet())
        && d.activo is bool
        && d.debe_cambiar_contrasena is bool
        && gestiona(d.nivel);
    }

    function empleadoValido() {
      let d = request.resource.data;
      return d.nombre_empleado is string
        && d.apellido_empleado is string
        && d.dni is string
        && d.estado is bool
        && d.correo is string
        && d.cargo is string
        && d.nivel_cargo == cargoDespues(d.cargo).nivel_acceso
        && gestiona(d.nivel_cargo);
    }

    function cargoValido() {
      let d = request.resource.data;
      return d.nombre_cargo is string
        && d.nombre_cargo.size() > 0
        && d.nivel_acceso is int
        && d.nivel_acceso >= 1
        && d.nivel_acceso <= 5
        && d.permisos is list
        && d.permisos_ids is list
        && gestiona(d.nivel_acceso);
    }

    // Solo el administrador reparte permisos que no tiene. Quitarlos sí está permitido.
    function permisosAgregadosPropios() {
      return miUsuario().nivel >= 5
        || request.resource.data.permisos.toSet()
             .difference(resource.data.permisos.toSet())
             .hasOnly(miUsuario().permisos);
    }

    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function catalogoValido(campoNombre) {
      return request.resource.data[campoNombre] is string
        && request.resource.data[campoNombre].size() > 0;
    }

    function mesaValida() {
      let d = request.resource.data;
      return d.numero_mesa is int
        && d.numero_mesa >= 1
        && d.ubicacion in ['salon', 'patio']
        && d.estado_mesa is bool;
    }

    // La fecha llega como texto: 2026-11-06
    function fechaNoFutura(fecha) {
      return timestamp.date(int(fecha[0:4]), int(fecha[5:7]), int(fecha[8:10])) <= request.time;
    }

    function gastoValido() {
      let d = request.resource.data;
      return d.descripcion is string
        && d.descripcion.size() > 0
        && d.monto is number
        && d.monto > 0
        && exists(/databases/$(database)/documents/categorias_gasto/$(d.categoria));
    }

    function ingredienteValido() {
      let d = request.resource.data;
      return d.nombre_ingrediente is string
        && d.nombre_ingrediente.size() > 0
        && d.nombre_ingrediente.size() <= 100
        && d.unidad_medida in ['kg', 'g', 'l', 'ml', 'u']
        && d.costo_unitario is number
        && d.costo_unitario >= 0
        && d.estado_ingrediente is bool;
    }

    // exists() cumple la función de una clave foránea: la categoría tiene que existir
    function platoValido() {
      let d = request.resource.data;
      return d.nombre_plato is string
        && d.nombre_plato.size() > 0
        && d.nombre_plato.size() <= 100
        && d.precio_plato is number
        && d.precio_plato > 0
        && d.estado_plato is bool
        && d.ingredientes_ids is list
        && d.ingredientes_ids.size() > 0
        && d.ingredientes is list
        && d.categoria is string
        && exists(/databases/$(database)/documents/categorias/$(d.categoria));
    }

    function bebidaValida() {
      let d = request.resource.data;
      return d.nombre_bebida is string
        && d.nombre_bebida.size() > 0
        && d.nombre_bebida.size() <= 50
        && d.precio_bebida is number
        && d.precio_bebida > 0
        && d.disponible_bebida is bool
        && d.id_tipo_bebida is string
        && exists(/databases/$(database)/documents/tipos_bebida/$(d.id_tipo_bebida));
    }

    // Nadie puede cobrar más que el total ni guardar una comanda sin productos
    function comandaValida() {
      let d = request.resource.data;
      return d.total_comanda is number
        && d.total_comanda >= 0
        && d.total_pagado is number
        && d.total_pagado >= 0
        && d.total_pagado <= d.total_comanda
        && d.saldo_pendiente is number
        && d.saldo_pendiente >= 0
        && d.items is list
        && d.items.size() > 0
        && d.pagos is list
        && d.estado_comanda in ['pendiente', 'en_preparacion', 'entregado', 'pagado', 'anulado'];
    }

    // Cada persona lee sus datos, aunque todavía deba cambiar la contraseña.
    match /usuarios/{id} {
      allow read: if verificado()
        && (correo() == id || tienePermiso('empleados:leer') || tienePermiso('cargos:modificar'));
      allow create: if tienePermiso('empleados:escribir')
        && usuarioValido()
        && request.resource.data.correo == id;
      allow update: if
        // Primer ingreso: cada uno solo puede marcar que ya cambió su contraseña
        (verificado() && correo() == id
          && soloCambia(['debe_cambiar_contrasena'])
          && request.resource.data.debe_cambiar_contrasena == false)
        // Cada uno puede cambiar su propio teléfono
        || (esEmpleado() && correo() == id && soloCambia(['telefono']))
        // Editar a un empleado de nivel menor. Nadie se puede dar de baja a sí mismo.
        || (tienePermiso('empleados:modificar')
          && gestiona(resource.data.nivel)
          && usuarioValido()
          && request.resource.data.correo == resource.data.correo
          && (correo() != id || request.resource.data.activo == true))
        // Dar de baja o reactivar
        || (tienePermiso('empleados:eliminar')
          && gestiona(resource.data.nivel)
          && soloCambia(['activo'])
          && correo() != id)
        // Un cargo cambió: se copia a sus empleados
        || (tienePermiso('cargos:modificar')
          && soloCambia(['cargo', 'nivel', 'permisos'])
          && usuarioValido());
      allow delete: if false;
    }

    match /empleados/{id} {
      allow read: if tienePermiso('empleados:leer') || tienePermiso('cargos:modificar');
      allow create: if tienePermiso('empleados:escribir') && empleadoValido();
      allow update: if
        // Cada uno puede cambiar su propio teléfono
        (esEmpleado() && resource.data.correo == correo() && soloCambia(['telefono']))
        || (tienePermiso('empleados:modificar')
          && gestiona(resource.data.nivel_cargo)
          && empleadoValido()
          && request.resource.data.correo == resource.data.correo
          && (resource.data.correo != correo() || request.resource.data.estado == true))
        || (tienePermiso('empleados:eliminar')
          && gestiona(resource.data.nivel_cargo)
          && soloCambia(['estado', 'fecha_baja'])
          && resource.data.correo != correo())
        || (tienePermiso('cargos:modificar')
          && soloCambia(['cargo_nombre', 'nivel_cargo'])
          && gestiona(request.resource.data.nivel_cargo));
      allow delete: if false;
    }

    // No contiene sueldos: el formulario de empleados necesita elegir un cargo
    match /cargos/{id} {
      allow read: if tienePermiso('cargos:leer') || tienePermiso('empleados:leer');
      allow create: if tienePermiso('cargos:escribir')
        && cargoValido()
        && request.resource.data.permisos.size() == 0
        && request.resource.data.total_empleados == 0;
      allow update: if
        (tienePermiso('cargos:modificar')
          && gestiona(resource.data.nivel_acceso)
          && cargoValido()
          && permisosAgregadosPropios()
          && request.resource.data.total_empleados == resource.data.total_empleados)
        // Al crear un empleado o cambiarlo de cargo, se actualiza el total
        || ((tienePermiso('empleados:escribir') || tienePermiso('empleados:modificar'))
          && soloCambia(['total_empleados']));
      allow delete: if tienePermiso('cargos:eliminar')
        && gestiona(resource.data.nivel_acceso)
        && resource.data.total_empleados == 0;
    }

    match /sueldos/{id} {
      allow read: if tienePermiso('cargos:leer');
      allow write: if (tienePermiso('cargos:escribir') || tienePermiso('cargos:modificar'))
        && request.resource.data.sueldo_cargo is number
        && request.resource.data.sueldo_cargo >= 0
        && gestiona(cargoDespues(id).nivel_acceso);
      allow delete: if tienePermiso('cargos:eliminar');
    }

    match /permisos/{id} {
      allow read: if tienePermiso('cargos:leer');
      allow create: if tienePermiso('cargos:escribir')
        && request.resource.data.modulo is string
        && request.resource.data.accion is string;
      // Eliminarlo se lo quita a todos los cargos
      allow delete: if tienePermiso('cargos:eliminar') && miUsuario().nivel >= 5;
    }

    match /ingredientes/{id} {
      // El formulario de platos necesita la lista de ingredientes
      allow read: if tienePermiso('ingredientes:leer') || tienePermiso('platos:leer');
      allow create: if tienePermiso('ingredientes:escribir') && ingredienteValido();
      allow update: if tienePermiso('ingredientes:modificar') && ingredienteValido();
      allow delete: if false;
    }

    match /platos/{id} {
      // La pantalla de inicio cuenta los platos, y cualquier empleado puede verla
      allow read: if esEmpleado();
      allow create: if tienePermiso('platos:escribir') && platoValido();
      // Quien gestiona ingredientes solo puede actualizar su copia y el estado del plato
      allow update: if (tienePermiso('ingredientes:modificar')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['ingredientes', 'estado_plato']))
        || (tienePermiso('platos:modificar') && platoValido())
        // Al renombrar una categoría, se actualiza la copia de su nombre
        || (tienePermiso('categorias:modificar') && soloCambia(['categoria_nombre']));
      allow delete: if false;
    }

    match /categorias/{id} {
      allow read: if tienePermiso('categorias:leer') || tienePermiso('platos:leer');
      allow create: if tienePermiso('categorias:escribir') && catalogoValido('nombre_categoria_plato');
      allow update: if tienePermiso('categorias:modificar') && catalogoValido('nombre_categoria_plato');
      allow delete: if tienePermiso('categorias:eliminar');
    }

    // La pantalla de inicio también cuenta las bebidas
    match /bebidas/{id} {
      allow read: if esEmpleado();
      allow create: if tienePermiso('bebidas:escribir') && bebidaValida();
      allow update: if tienePermiso('bebidas:modificar') && bebidaValida();
      allow delete: if false;
    }

    match /tipos_bebida/{id} {
      allow read: if tienePermiso('bebidas:leer');
      allow create: if tienePermiso('bebidas:escribir') && catalogoValido('nombre_tipo_bebida');
      allow update: if tienePermiso('bebidas:modificar') && catalogoValido('nombre_tipo_bebida');
      allow delete: if tienePermiso('bebidas:eliminar');
    }

    match /tipos_asistencia/{id} {
      allow read: if tienePermiso('empleados:leer');
      allow create: if tienePermiso('empleados:escribir') && catalogoValido('nombre_tipo_asis');
      allow update: if tienePermiso('empleados:modificar') && catalogoValido('nombre_tipo_asis');
      allow delete: if tienePermiso('empleados:eliminar');
    }

    // El id es empleado_fecha: un empleado no puede tener dos asistencias el mismo día
    match /asistencias/{id} {
      allow read: if tienePermiso('empleados:leer');
      allow create: if tienePermiso('empleados:escribir')
        && request.resource.data.id_asistencia == id
        && id == request.resource.data.empleado + '_' + request.resource.data.fecha
        && fechaNoFutura(request.resource.data.fecha)
        && exists(/databases/$(database)/documents/empleados/$(request.resource.data.empleado))
        && exists(/databases/$(database)/documents/tipos_asistencia/$(request.resource.data.tipo));
      // Solo se puede cambiar el turno
      allow update: if tienePermiso('empleados:modificar')
        && soloCambia(['tipo', 'tipo_nombre'])
        && exists(/databases/$(database)/documents/tipos_asistencia/$(request.resource.data.tipo));
      allow delete: if tienePermiso('empleados:eliminar');
    }

    // La pantalla de inicio también cuenta estas colecciones
    match /mesas/{id} {
      allow read: if esEmpleado();
      allow create: if tienePermiso('mesas:escribir') && mesaValida() && request.resource.data.id_mesa == id;
      // Crear, cobrar o anular una comanda también ocupa o libera la mesa
      allow update: if ((tienePermiso('mesas:modificar')
            || tienePermiso('comandas:escribir')
            || tienePermiso('comandas:modificar')
            || tienePermiso('comandas:eliminar'))
          && request.resource.data.estado_mesa is bool
          && soloCambia(['estado_mesa']))
        // Editar el número y la ubicación
        || (tienePermiso('mesas:modificar')
          && mesaValida()
          && soloCambia(['numero_mesa', 'ubicacion', 'ubicacion_nombre']));
      allow delete: if tienePermiso('mesas:eliminar');
    }

    match /comandas/{id} {
      // Inicio y Mesas necesitan consultar las comandas abiertas
      allow read: if esEmpleado();
      // Una comanda nueva empieza pendiente, y queda a nombre de quien la crea
      allow create: if tienePermiso('comandas:escribir')
        && comandaValida()
        && request.resource.data.estado_comanda == 'pendiente'
        && request.resource.data.id_comanda == id
        && request.resource.data.fecha_hora is timestamp
        && request.resource.data.empleado == miUsuario().id_empleado
        && exists(/databases/$(database)/documents/mesas/$(request.resource.data.mesa));
      // Una comanda cerrada ya no cambia, y nunca cambian su mesa, su mozo ni su fecha
      allow update: if tienePermiso('comandas:modificar')
        && resource.data.estado_comanda in ['pendiente', 'en_preparacion', 'entregado']
        && comandaValida()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'estado_comanda', 'estado_nombre', 'observaciones_comanda', 'total_comanda',
             'total_pagado', 'saldo_pendiente', 'fecha_anulacion', 'motivo_anulacion',
             'usuario_anulacion', 'items', 'pagos'
           ]);
      // Solo si sigue abierta y sin pagos
      allow delete: if tienePermiso('comandas:eliminar')
        && resource.data.estado_comanda in ['pendiente', 'en_preparacion', 'entregado']
        && resource.data.pagos.size() == 0;
    }

    // El registro de cambios: cada uno firma lo suyo, y nadie puede editarlo ni borrarlo
    match /auditoria/{id} {
      allow read: if tienePermiso('auditoria:leer');
      allow create: if esEmpleado()
        && request.resource.data.empleado == miUsuario().id_empleado
        && request.resource.data.tabla is string
        && request.resource.data.accion in ['CREAR', 'MODIFICAR', 'ANULAR', 'ELIMINAR']
        && request.resource.data.fecha_hora is timestamp;
      allow update, delete: if false;
    }

    match /categorias_gasto/{id} {
      allow read: if tienePermiso('caja:leer');
      allow create: if tienePermiso('caja:escribir') && catalogoValido('nombre_categoria_gasto');
      allow update: if tienePermiso('caja:modificar') && catalogoValido('nombre_categoria_gasto');
      allow delete: if tienePermiso('caja:eliminar');
    }

    match /metodos_pago/{id} {
      // Quien cobra una comanda necesita ver las opciones
      allow read: if esEmpleado();
      allow create: if tienePermiso('caja:escribir') && catalogoValido('nombre_metodo_pago');
      allow update: if tienePermiso('caja:modificar') && catalogoValido('nombre_metodo_pago');
      allow delete: if tienePermiso('caja:eliminar');
    }

    match /cajas/{id} {
      allow read: if tienePermiso('caja:leer');
      // Una caja nueva empieza abierta y a nombre de quien la abre
      allow create: if tienePermiso('caja:escribir')
        && request.resource.data.id_caja == id
        && request.resource.data.estado_caja == 'abierto'
        && request.resource.data.total_egresos == 0
        && request.resource.data.saldo_inicial is number
        && request.resource.data.saldo_inicial >= 0
        && request.resource.data.empleado_apertura == miUsuario().id_empleado
        && getAfter(/databases/$(database)/documents/contadores/cajas).data.abierta == id;
      // Una caja cerrada ya no cambia, y sus datos de apertura tampoco
      allow update: if resource.data.estado_caja == 'abierto'
        && ((tienePermiso('caja:modificar')
            && soloCambia(['saldo_esperado', 'saldo_contado', 'diferencia_caja', 'observaciones_arqueo',
                           'empleado_arqueo_nombre', 'fecha_arqueo', 'estado_caja', 'fecha_cierre',
                           'empleado_cierre_nombre', 'saldo_final', 'observaciones_cierre'])
            && request.resource.data.estado_caja in ['abierto', 'cerrado'])
          // Registrar, editar o eliminar un gasto actualiza el total
          || ((tienePermiso('caja:escribir') || tienePermiso('caja:modificar') || tienePermiso('caja:eliminar'))
            && soloCambia(['total_egresos'])
            && request.resource.data.total_egresos >= 0));
      allow delete: if false;
    }

    // Numeración de las cajas, y cuál está abierta. Solo puede haber una.
    match /contadores/cajas {
      allow read: if tienePermiso('caja:leer') || tienePermiso('caja:escribir');
      allow create: if tienePermiso('caja:escribir')
        && request.resource.data.ultimo == 1
        && request.resource.data.abierta == '1';
      // Abrir: solo si no hay otra abierta. Cerrar: deja el contador sin caja abierta.
      allow update: if (tienePermiso('caja:escribir')
          && resource.data.abierta == null
          && request.resource.data.ultimo == resource.data.ultimo + 1
          && request.resource.data.abierta == string(request.resource.data.ultimo))
        || (tienePermiso('caja:modificar')
          && request.resource.data.ultimo == resource.data.ultimo
          && request.resource.data.abierta == null);
    }

    match /gastos/{id} {
      allow read: if tienePermiso('caja:leer');
      // Solo en una caja abierta, y a nombre de quien lo registra
      allow create: if tienePermiso('caja:escribir')
        && gastoValido()
        && request.resource.data.id_gasto == id
        && request.resource.data.empleado == miUsuario().id_empleado
        && get(/databases/$(database)/documents/cajas/$(request.resource.data.caja)).data.estado_caja == 'abierto';
      allow update: if tienePermiso('caja:modificar')
        && gastoValido()
        && soloCambia(['descripcion', 'monto', 'categoria', 'categoria_nombre'])
        && get(/databases/$(database)/documents/cajas/$(resource.data.caja)).data.estado_caja == 'abierto';
      allow delete: if tienePermiso('caja:eliminar')
        && get(/databases/$(database)/documents/cajas/$(resource.data.caja)).data.estado_caja == 'abierto';
    }

    // Numeración de las comandas: solo puede avanzar de a uno
    match /contadores/comandas {
      allow read: if tienePermiso('comandas:escribir');
      allow update: if tienePermiso('comandas:escribir')
        && request.resource.data.ultimo == resource.data.ultimo + 1;
    }

    // Todo lo que no esté indicado arriba queda bloqueado
  }
}
